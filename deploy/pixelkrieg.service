# systemd-Dienst: startet Pixelkrieg beim Booten und nach Abstürzen neu.
# Nach /etc/systemd/system/ kopieren, dann:
#   systemctl daemon-reload && systemctl enable --now pixelkrieg
[Unit]
Description=Pixelkrieg
After=network.target

[Service]
User=pixelkrieg
WorkingDirectory=/opt/pixelkrieg
# Geheimnis NICHT in die config.toml schreiben, sondern hier bzw. in einer
# EnvironmentFile mit Rechten 600.
EnvironmentFile=/etc/pixelkrieg.env
# WICHTIG: genau EIN Prozess (kein --workers). Leinwand, Rate-Limit und
# WebSocket-Verteilung liegen im Speicher dieses einen Prozesses.
ExecStart=/opt/pixelkrieg/.venv/bin/uvicorn pixelkrieg.main:create_app --factory --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
